NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://modett:modett@localhost:5432/modett
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_DOMAIN=
LOG_LEVEL=info
# Secret Cloudflare sends on CF_ORIGIN_SECRET_HEADER so cf-ipcountry can be trusted. Required in production (at least 16 characters). Leave empty outside production to trust cf-ipcountry as sent.
CF_ORIGIN_SECRET=
# Header name that carries the Cloudflare origin secret.
CF_ORIGIN_SECRET_HEADER=x-cf-origin-secret
# Two-letter ISO country code used instead of cf-ipcountry. Must not be set in production.
DEV_COUNTRY_OVERRIDE=
